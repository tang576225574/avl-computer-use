FRONTEND_PORT=8081
BACKEND_PORT=8080
BACKEND_HTTPS=0


# === noVNC ===
# 前端 iframe 走同源 /novnc/* proxy；Vite dev server 把它转发到下面这个上游地址
# - 如果 uvicorn 跑在目标桌面容器内部：填 http://localhost:6902
# - 如果跨容器：填 http://<目标容器在 host 上映射的地址>:<映射端口>
# 改这一行即可切到任意 noVNC 实例，不用动代码
NOVNC_ADDRESS=https://localhost:6902
NOVNC_USE_HTTPS=1
NOVNC_SSL_PEM=/usr/libexec/noVNCdim/ssl/self.pem


AVL_SUDO_PASSWORD=
AVL_STREAM_IDLE_MS

