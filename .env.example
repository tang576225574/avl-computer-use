# 桌面容器：将模板复制到 .local/desktop.env，填写下面两项，再用 docker run --env-file .local/desktop.env。
# 可选项默认注释；只在对应进程启用所需设置。模型端单独配置，完整用法见 README.md「环境变量」。
# Docker env 文件填字面值，不加引号。随机凭据在终端生成后填入，不要把生成命令写在等号后。

# 必填。部署者自定义的 avl-ops 运维密码，无需从容器获取。单行非空，最多 512 字节。
# 仅传桌面容器；本地直接启动 tools/dsh.sh 时必须取消此变量。
AVL_SUDO_PASSWORD=
# 必填。部署者生成一次（例如 openssl rand -hex 32），保存后将同一值传给 Host 和视觉适配器。
# 不含空白或控制字符，容器最多接受 512 字节，须区别于运维密码。
AVL_MODEL_TOKEN=
# 可选。独立只读 VNC/noVNC 的密码，用户可设 6–8 个可打印 ASCII 字符，与上述两项不同。
# 不填则容器每次启动随机生成且不显示；需独立登录时启动前指定。DSH 网页面板无需此密码。
# AVL_NOVNC_PASSWORD=

# DSH Host。DSH_BIND 不填则本地使用回环地址，容器使用自身接口地址。
# DSH_BIND=127.0.0.1
# 网页与模型 WebSocket 共用的监听端口。
# DSH_PORT=3080
# 浏览器实际访问的 HTTP(S) 根地址，默认未设置。跨机器部署使用实际 HTTPS 入口。
# DSH_PUBLIC_URL=https://desktop.example.org
# DSH 状态与会话的可写绝对路径。默认是桌面用户家目录下的 .local/state/avl-dsh。
# DSH_HOME=/var/lib/avl-dsh

# 目标采集帧率，整数 12–24。
# AVL_CAPTURE_FPS=24
# 单连接写入超时，1–2147483647 毫秒；超时断开该连接。
# AVL_STREAM_WRITE_TIMEOUT_MS=1000
# 两步间视频空闲多久停送模型帧，100–86400000 毫秒；继续保留租约。
# AVL_STREAM_IDLE_MS=60000
# 动作依据帧最大年龄，100–60000 毫秒。
# AVL_FRAME_FRESH_MS=5000
# 单次视觉决策最长等待时间，100–180000 毫秒。
# AVL_STEP_TIMEOUT_MS=30000
# 设为 1 使用合成画面并禁用输入，本地观察测试用。
# AVL_SYNTHETIC=0

# 桌面运维。本地默认关闭，容器入口固定开启。
# AVL_MANAGE_DESKTOP=0
# sshd 监听和探测端口（1–65535）。
# AVL_SSHD_PORT=22
# X11 目标显示号。本地沿用会话设置，未设置时回退到 :1。
# DISPLAY=:1
# X11 授权文件路径。本地沿用目标会话值，下面是容器入口自动设置的路径。
# XAUTHORITY=/run/avl/desktop/Xauthority
# 本地受管桌面的运行目录与会话总线，容器入口自动设置以下值。
# XDG_RUNTIME_DIR=/run/avl/desktop
# DBUS_SESSION_BUS_ADDRESS=unix:path=/run/avl/desktop/bus
# noVNC 安装目录、Xvnc 端口、noVNC 网页和 WebSocket 端口。两端口均监听回环。
# NOVNC_HOME=/usr/libexec/noVNCdim
# VNC_PORT=5902
# NOVNC_PORT=6902
# 受管 Xvnc 的分辨率和颜色深度。基础镜像有设置时沿用镜像值。
# VNC_RESOLUTION=1920x1080
# VNC_COL_DEPTH=24

# 仅视觉模型端。除上述同一份 AVL_MODEL_TOKEN 外，按需配置：
# Host 视频入口。回环可用 ws；跨机器必须用 wss，例如 wss://desktop.example.org/avl/model。
# AVL_MODEL_WS=ws://127.0.0.1:3080/avl/model
# Omni 推理 API 的根地址、服务端已发布的模型 ID（适配器和定位评估共用）。
# AVL_OMNI_BASE_URL=http://127.0.0.1:8000/v1
# AVL_OMNI_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 推理端启用鉴权时填服务商签发或自部署管理员配置的 Key；无鉴权留空。只传模型机器。
# AVL_OMNI_API_KEY=
# 后台视觉采样推理频率，大于 0 且不超过 24，可为小数。
# AVL_SIM_INFERENCE_FPS=2

# 仅 node tests/benchmark.mjs。每场测量秒数（至少 3）、延迟场景的注入毫秒数（0–1000）。
# AVL_BENCH_SECONDS=8
# AVL_BENCH_DELAY_MS=35
# 基准默认使用合成画面。要测真实桌面，填写显示号并传对应 XAUTHORITY。
# AVL_BENCH_DISPLAY=:1
# 基准使用的 Python 解释器。
# PYTHON=python3

# DESKTOP_IMAGE 通过 docker build --build-arg 传入。HEADLESS_USER_NAME 来自基础镜像。
# AVL_MODEL_TOKEN_FD 是 Host 启动器的内部描述符标记，无需在这里赋值。
